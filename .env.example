# ==============================================================================
# Groww Trade API Configuration
# ==============================================================================
# Provider selection: 'groww' (Real Groww Trade API), 'kite' (Zerodha), or 'demo' (Offline Mock)
MARKET_DATA_PROVIDER=groww

# Groww API Credentials (Get from https://groww.in/trade-api/api-keys)
# GROWW_API_KEY: Generated API Key (or TOTP Token from Groww developer dashboard)
GROWW_API_KEY=your_groww_api_key_here

# GROWW_API_SECRET: Generated Secret or TOTP Base32 Secret Key (e.g. from TOTP generation)
GROWW_API_SECRET=your_groww_api_secret_here

# Optional: Directly provide an active Groww session access token if pre-generated
GROWW_ACCESS_TOKEN=

# Optional: Base URL override (defaults to https://api.groww.in/v1)
GROWW_BASE_URL=https://api.groww.in/v1

# Environment: 'production' or 'sandbox'
MARKET_DATA_ENVIRONMENT=production
